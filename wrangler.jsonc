{
  // Cloudflare Worker serving this static site. Deploy with: npx wrangler deploy
  "name": "importfromchina",
  "compatibility_date": "2026-09-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
